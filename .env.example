# Database
DATABASE_URL=postgresql://posuser:localpass@postgres:5432/posdb
POSTGRES_USER=posuser
POSTGRES_PASSWORD=localpass
POSTGRES_DB=posdb

# JWT
JWT_SECRET=local-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Features (Локално)
STRIPE_ENABLED=false
EMAIL_ENABLED=false
SUBSCRIPTION_CHECKS_ENABLED=false

# Stripe (празно за локално)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Environment
ENVIRONMENT=development
DEBUG=true
